# This is the primary file for code development and data analysis.
# I hope to avoid merge conflicts by leaving each machine its own main file.
# (this is effectively an alternative to branches since I'm the only developer)
*main*

# Ignore private data files. These are often temporary or for testing purposes.
# I will be using private data on all machines, so made it a general part of project.
data_private/*
!data_private/.gitkeep

# Simulation videos are automatically generated with the following title.
# If meant to be shared, they will be renamed.
output.mp4

# Mac OS X temporary files
*DS_Store

# Temporary files when running scripts
*.asv

# The following are old files whose functionality has been adapted into
# others. I am leaving them on my local machine for reference, but they
# are not needed in the repository.
derivative_noise.m
particle_feuler_noise.m
stationary_soln_v.m